{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencade:contracts:release-v1.schema.json",
  "title": "Livraison (ARCH-001 § livraison) : sur-ensemble de release-manifest/1 écrit par publier-opencade.py",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "releaseId",
    "commitSha",
    "specVersions",
    "componentVersions",
    "assetLock",
    "levelLock",
    "sbomRef",
    "testEvidence",
    "policyDecisions",
    "deploymentRef"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "releaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@#+-]+$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "specVersions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "fichier",
          "sha256"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:/@#+-]+$"
          },
          "fichier": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "componentVersions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9._:/@#+-]+$"
      }
    },
    "assetLock": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "registryCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "assets": {
          "type": "integer"
        }
      }
    },
    "levelLock": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "aucun": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sbomRef": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "specVersion": {
          "type": "string"
        },
        "components": {
          "type": "integer"
        }
      }
    },
    "testEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "uri",
          "kind"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:/@#+-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "policyDecisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9._:/@#+-]+$"
      }
    },
    "deploymentRef": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9._:/@#+-]+$"
      }
    }
  }
}
