{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencade:contracts:task-v1.schema.json",
  "title": "Tâche (ticket YouTrack HL-n) rattachée à un projet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "projectId",
    "title",
    "status"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@#+-]+$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@#+-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "todo",
        "in_progress",
        "blocked",
        "done"
      ]
    },
    "specRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9._:/@#+-]+$"
      }
    },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9._:/@#+-]+$"
      }
    }
  }
}
