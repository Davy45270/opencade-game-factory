{
  "$id": "https://opencade.invalid/schemas/sheet.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "license": {
            "not": {
              "const": "unknown"
            }
          }
        },
        "required": [
          "license"
        ]
      },
      "then": {
        "required": [
          "licenseEvidence"
        ]
      }
    }
  ],
  "properties": {
    "dimensions": {
      "$ref": "asset.schema.json#/$defs/dimensions"
    },
    "files": {
      "$ref": "asset.schema.json#/$defs/files"
    },
    "id": {
      "$ref": "asset.schema.json#/$defs/sheetId"
    },
    "license": {
      "$ref": "asset.schema.json#/$defs/license"
    },
    "licenseEvidence": {
      "$ref": "asset.schema.json#/$defs/evidence"
    },
    "name": {
      "pattern": "\\S",
      "type": "string"
    },
    "provenance": {
      "$ref": "asset.schema.json#/$defs/provenance"
    },
    "regions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assetId": {
            "anyOf": [
              {
                "$ref": "asset.schema.json#/$defs/assetId"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "$ref": "asset.schema.json#/$defs/evidence"
          },
          "h": {
            "minimum": 1,
            "type": "integer"
          },
          "status": {
            "enum": [
              "verified",
              "candidate",
              "needs-review"
            ]
          },
          "w": {
            "minimum": 1,
            "type": "integer"
          },
          "x": {
            "minimum": 0,
            "type": "integer"
          },
          "y": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "x",
          "y",
          "w",
          "h",
          "assetId",
          "status",
          "evidence"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "sha256": {
      "$ref": "asset.schema.json#/$defs/sha256"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "sha256",
    "dimensions",
    "files",
    "provenance",
    "license",
    "regions"
  ],
  "type": "object"
}
