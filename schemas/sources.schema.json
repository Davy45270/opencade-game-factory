{
  "$defs": {
    "entry": {
      "additionalProperties": false,
      "properties": {
        "copies": {
          "items": {
            "additionalProperties": false,
            "else": {
              "not": {
                "required": [
                  "path"
                ]
              },
              "required": [
                "url"
              ]
            },
            "if": {
              "properties": {
                "provider": {
                  "const": "local"
                }
              }
            },
            "properties": {
              "defaultBranch": {
                "pattern": "\\S",
                "type": "string"
              },
              "path": {
                "pattern": "^/[^\\x00-\\x1f]+$",
                "type": "string"
              },
              "provider": {
                "enum": [
                  "github",
                  "forgejo",
                  "local"
                ]
              },
              "url": {
                "format": "repository-url",
                "pattern": "^https?://[^/@\\s]+(?:/[^\\s]*)?$",
                "type": "string"
              },
              "visibility": {
                "enum": [
                  "public",
                  "private",
                  "unknown"
                ]
              }
            },
            "required": [
              "provider",
              "defaultBranch"
            ],
            "then": {
              "not": {
                "required": [
                  "url"
                ]
              },
              "required": [
                "path"
              ]
            },
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "games": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "generatedResources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "generator", "mentions"],
            "properties": {
              "path": {
                "anyOf": [
                  {"$ref": "#/$defs/literalPath"},
                  {"$ref": "#/$defs/pathAliasPattern"}
                ]
              },
              "generator": {"$ref": "#/$defs/literalPath"},
              "mentions": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "name": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
          "type": "string"
        },
        "pathAliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": {"$ref": "#/$defs/pathAliasPattern"},
              "to": {"$ref": "#/$defs/pathAliasPattern"}
            }
          }
        },
        "role": {
          "enum": [
            "game",
            "shared-library"
          ]
        },
        "publicationGrants": {
          "description": "Autorisations explicites de publication, par jeu, des assets sous licence privée qu'il emploie : décision du propriétaire et référence YouTrack (HL-538).",
          "items": {
            "additionalProperties": false,
            "properties": {
              "decision": {
                "pattern": "\\S",
                "type": "string"
              },
              "license": {
                "const": "LicenseRef-David-Prive-Tous-Droits-Reserves"
              },
              "ref": {
                "pattern": "\\S",
                "type": "string"
              }
            },
            "required": [
              "license",
              "ref",
              "decision"
            ],
            "type": "object"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "role",
        "games",
        "copies"
      ],
      "type": "object"
    },
    "literalPath": {
      "type": "string",
      "pattern": "^(?:(?!\\.{1,2}/)[^/\\\\*?#:\\x00-\\x1f]+/)*(?!\\.{1,2}(?![\\s\\S]))[^/\\\\*?#:\\x00-\\x1f]+(?![\\s\\S])"
    },
    "pathAliasPattern": {
      "type": "string",
      "pattern": "^(?:(?!\\.{1,2}/)[^/\\\\*?#:\\x00-\\x1f]+/)*[^/\\\\*?#:\\x00-\\x1f]*\\*[^/\\\\*?#:\\x00-\\x1f]*(?![\\s\\S])"
    }
  },
  "$id": "https://opencade.invalid/schemas/sources.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "excluded": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
            "type": "string"
          },
          "reason": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "name",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/entry"
      },
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "sources",
    "excluded"
  ],
  "type": "object"
}
