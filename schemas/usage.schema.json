{
  "$id": "https://opencade.invalid/schemas/usage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "else": {
    "required": [
      "removedAtCommit"
    ]
  },
  "if": {
    "properties": {
      "status": {
        "const": "active"
      }
    }
  },
  "properties": {
    "assetBlobs": {
      "additionalProperties": {
        "$ref": "asset.schema.json#/$defs/commit"
      },
      "minProperties": 1,
      "propertyNames": {
        "$ref": "asset.schema.json#/$defs/path"
      },
      "type": "object"
    },
    "assetPath": {
      "$ref": "asset.schema.json#/$defs/files/properties/locations/items/properties/path"
    },
    "codeRef": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "$ref": "asset.schema.json#/$defs/path"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "type": "object"
    },
    "commit": {
      "$ref": "asset.schema.json#/$defs/commit"
    },
    "evidence": {
      "$ref": "asset.schema.json#/$defs/evidence"
    },
    "game": {
      "pattern": "\\S",
      "type": "string"
    },
    "importName": {
      "pattern": "\\S",
      "type": "string"
    },
    "inference": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "asset.schema.json#/properties/inference/properties/description"
        }
      },
      "required": [
        "role"
      ],
      "type": "object"
    },
    "provider": {
      "enum": [
        "github",
        "forgejo",
        "local"
      ]
    },
    "releases": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "removedAtCommit": {
      "$ref": "asset.schema.json#/$defs/commit"
    },
    "repo": {
      "pattern": "\\S",
      "type": "string"
    },
    "role": {
      "pattern": "\\S",
      "type": "string"
    },
    "scene": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "removed"
      ]
    }
  },
  "required": [
    "repo",
    "game",
    "scene",
    "commit",
    "codeRef",
    "role",
    "importName",
    "evidence",
    "status",
    "releases"
  ],
  "then": {
    "not": {
      "required": [
        "removedAtCommit"
      ]
    }
  },
  "type": "object"
}
