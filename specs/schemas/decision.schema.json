{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencade:specs:decision",
  "title": "Décisions liées à une spec : référence BB/ADR, ou arbitrage de version par David (REG-003)",
  "$defs": {
    "reference": {
      "type": "string",
      "pattern": "^(?:BB|ADR)-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "arbitrage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "ref"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "ref": {
          "type": "string",
          "pattern": "^HL-[0-9]+ 7-[0-9]+$"
        }
      }
    }
  }
}
