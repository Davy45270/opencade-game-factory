{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencade:specs:dependency",
  "title": "Dépendance typée entre specs (REG-003 § 3, relations d'une fiche)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "target"
  ],
  "properties": {
    "type": {
      "enum": [
        "requires",
        "implements",
        "tested-by",
        "supersedes",
        "conflicts-with",
        "reuses",
        "consumes",
        "produces",
        "deployed-in"
      ]
    },
    "target": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "range": {
      "type": "string",
      "pattern": "^(?:\\^|~|>=|=)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
