{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencade:specs:requirement",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "matrixId", "statement", "matrixStatus", "source"],
  "properties": {
    "id": {"type": "string", "pattern": "^REQ-[A-Z0-9]+(?:-[A-Z0-9]+)*-E(?:[0-9]{3,}[A-Z]?|-[A-Z0-9]+(?:-[A-Z0-9]+)*)$"},
    "matrixId": {"type": "string", "pattern": "^E(?:[0-9]{3,}[a-z]?|-[a-z0-9]+(?:-[a-z0-9]+)*)$"},
    "statement": {"type": "string", "minLength": 1},
    "matrixStatus": {"enum": ["a_faire", "faite", "ecartee"]},
    "acceptance": {"type": "string"},
    "criticality": {"enum": ["P0", "P1", "P2", "P3", "unknown"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "anchor": {"type": "string"}
      }
    },
    "arbitrage": {"type": "object"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number"]},
        "threshold": {"type": ["string", "number"]}
      }
    }
  }
}
