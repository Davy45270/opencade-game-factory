{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencade:specs:specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "project",
    "title",
    "owner",
    "lifecycle",
    "implementation",
    "evidence",
    "visibility",
    "canonical",
    "versions",
    "requirements"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SPEC-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "documents"
        ],
        "properties": {
          "version": {
            "$ref": "#/$defs/version"
          },
          "documents": {
            "$ref": "#/$defs/documents",
            "minItems": 1
          }
        }
      }
    },
    "unversionedDocuments": {
      "$ref": "#/$defs/documents"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "urn:opencade:specs:requirement"
      }
    },
    "relations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:opencade:specs:dependency"
      }
    },
    "arbitration": {
      "$ref": "urn:opencade:specs:decision#/$defs/arbitrage"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "lifecycle": {
      "enum": [
        "draft",
        "approved",
        "deprecated",
        "retired"
      ]
    },
    "lifecycleRef": {
      "type": "string",
      "pattern": "^HL-[0-9]+ 7-[0-9]+$"
    },
    "implementation": {
      "$ref": "urn:opencade:specs:implementation"
    },
    "evidence": {
      "enum": [
        "missing",
        "unverified",
        "verified"
      ]
    },
    "visibility": {
      "enum": [
        "private",
        "public"
      ]
    },
    "visibilityRef": {
      "type": "string",
      "pattern": "^HL-[0-9]+ 7-[0-9]+$"
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editableIn",
        "path",
        "importedFrom"
      ],
      "properties": {
        "editableIn": {
          "const": "usine"
        },
        "path": {
          "type": "string",
          "pattern": "^specs/registry/(?:games|platform|shared|decisions)/SPEC-[A-Z0-9-]+\\.json$"
        },
        "importedFrom": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "commitSha"
          ],
          "properties": {
            "repo": {
              "const": "homelab-docs"
            },
            "commitSha": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            }
          }
        }
      }
    },
    "importOrigins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drive",
        "authority"
      ],
      "properties": {
        "drive": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{25,44}$"
          }
        },
        "authority": {
          "const": "usine"
        }
      }
    },
    "decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:opencade:specs:decision#/$defs/reference"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "provenances"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "provenances": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repo",
                "path",
                "commitSha"
              ],
              "properties": {
                "repo": {
                  "const": "homelab-docs"
                },
                "path": {
                  "type": "string",
                  "pattern": "^specs/[a-z0-9-]+-sources(?:-(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))?/(?!.*(?:^|/)\\.\\.?(?:/|$))(?!/)[^\\\\\\u0000-\\u001f]+$"
                },
                "commitSha": {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                }
              }
            }
          }
        }
      }
    }
  }
}
