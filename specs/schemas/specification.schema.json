{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencade:specs:specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project", "versions", "requirements"],
  "properties": {
    "id": {"type": "string", "pattern": "^SPEC-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
    "project": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "documents"],
        "properties": {
          "version": {"$ref": "#/$defs/version"},
          "documents": {"$ref": "#/$defs/documents", "minItems": 1}
        }
      }
    },
    "unversionedDocuments": {"$ref": "#/$defs/documents"},
    "requirements": {
      "type": "array",
      "items": {"$ref": "urn:opencade:specs:requirement"}
    },
    "relations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target"],
        "properties": {
          "type": {"enum": ["requires", "implements", "tested-by", "supersedes", "conflicts-with", "reuses", "consumes", "produces", "deployed-in"]},
          "target": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}
        }
      }
    },
    "arbitration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "ref"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "ref": {"type": "string", "pattern": "^HL-[0-9]+ 7-[0-9]+$"}
      }
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "provenances"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "provenances": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repo", "path", "commitSha"],
              "properties": {
                "repo": {"const": "homelab-docs"},
                "path": {"type": "string", "pattern": "^specs/[a-z0-9-]+-sources(?:-(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))?/(?!.*(?:^|/)\\.\\.?(?:/|$))(?!/)[^\\\\\\u0000-\\u001f]+$"},
                "commitSha": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"}
              }
            }
          }
        }
      }
    }
  }
}
